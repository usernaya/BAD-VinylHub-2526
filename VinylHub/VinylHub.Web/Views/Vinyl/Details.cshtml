@model VinylHub.Domain.Entities.Vinyl

@{
    ViewData["Title"] = Model.Title;
}

<h1>@Model.Title</h1>

<div class="row">
    <div class="col-md-4">
        @if (Model.CoverImageUrl != null)
        {
            <img src="@Model.CoverImageUrl" class="img-fluid" />
        }
        else
        {
            <p>Geen afbeelding beschikbaar</p>
        }
    </div>
    <div class="col-md-8">
        <table class="table table-hover">
            <tr>
                <th>Artiest</th>
                <td>
                    <a asp-controller="Artist" asp-action="Details" asp-route-id="@Model.Artist.Id">@Model.Artist.Name</a>
                </td>
            </tr>
            <tr>
                <th>Genre</th>
                <td>
                    <a asp-controller="Genre" asp-action="Details" asp-route-id="@Model.Genre.Id">@Model.Genre.Name</a>
                </td>
            </tr>
            <tr>
                <th>Jaar</th>
                <td>@Model.ReleaseYear</td>
            </tr>
            <tr>
                <th>Label</th>
                <td>@Model.Label</td>
            </tr>
            <tr>
                <th>Beschrijving</th>
                <td>@Model.Description</td>
            </tr>
            <tr>
                <th>Beschikbaar</th>
                <td>
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">Beschikbaar</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Uitgeleend</span>
                    }
                </td>
            </tr>
        </table>

        @if (Model.IsAvailable && User.Identity.IsAuthenticated)
        {
            <a asp-controller="Loan" asp-action="Create" asp-route-vinylId="@Model.Id" class="btn btn-primary">Lenen</a>
        }

        @if (User.HasClaim("IsAdmin", ""))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Bewerken</a>
            <form asp-action="Delete" method="post" style="display:inline">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Verwijderen</button>
            </form>
        }

        <a asp-action="Index" class="btn btn-secondary mt-2">Terug naar collectie</a>
    </div>
</div>