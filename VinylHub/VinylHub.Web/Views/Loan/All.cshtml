@model VinylHub.Web.ViewModels.LoanFilterViewModel
@using VinylHub.Domain.Enums

@{
    ViewData["Title"] = "Alle leningen";
}

<h1>Alle leningen</h1>

@* filter formulier *@
<form asp-action="All" method="get" class="mb-4">
    <div class="row g-3">
        <div class="col-md-3">
            <select name="status" class="form-select" asp-items="Model.Statuses">
                <option value=""> - Alle statussen - </option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filteren</button>
        </div>
        <div class="col-md-2">
            <a asp-action="All" class="btn btn-secondary w-100">Wissen</a>
        </div>
    </div>
</form>

@if (!Model.Loans.Any())
{
    <p>Geen leningen gevonden.</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Gebruiker</th>
                <th>Vinyl</th>
                <th>Artiest</th>
                <th>Startdatum</th>
                <th>Terugbrengdatum</th>
                <th>Teruggegeven op</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>@loan.BorrowerName</td>
                    <td>@loan.Vinyl.Title</td>
                    <td>@loan.Vinyl.Artist.Name</td>
                    <td>@loan.StartDate.ToString("dd/MM/yyyy")</td>
                    <td>@loan.DueDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (loan.ReturnDate != null)
                        {
                            @loan.ReturnDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (loan.Status == LoanStatus.Returned)
                        {
                            <span class="badge bg-success">Teruggegeven</span>
                        }
                        else if (loan.Status == LoanStatus.Overdue)
                        {
                            <span class="badge bg-danger">Te laat</span>
                        }
                        else if (loan.Status == LoanStatus.Cancelled)
                        {
                            <span class="badge bg-secondary">Geannuleerd</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Actief</span>
                        }
                    </td>
                    <td>
                        @if (loan.Status == LoanStatus.Active || loan.Status == LoanStatus.Overdue)
                        {
                            <form asp-action="Return" method="post" style="display:inline">
                                <input type="hidden" name="loanId" value="@loan.Id" />
                                <button type="submit" class="btn btn-sm btn-success">Terugbrengen</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Vinyl" asp-action="Index" class="btn btn-secondary">Terug naar collectie</a>